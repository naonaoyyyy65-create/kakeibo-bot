LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
PORT=3000
# 読み取り専用GraphQL API（graphqlServer.js）のポート。省略時は4000
GRAPHQL_PORT=4000
# リマインドの本番送信先（利用者2人のLINE User IDをカンマ区切りで）。
# usersシート（getAllUserIds）は開発中のテスト用IDが混入しうるため送信先には使わない。
NOTIFY_USER_IDS=
# リマインドのデバッグ送信先（reminder.js --debug時のみ使用、テスト用1名のLINE User ID）。
REMINDER_USER_IDS=
# 任意: バックアップJSONのオフサイト保存先Google DriveフォルダID。
# 未設定ならローカル保存（backup/）のみでDriveへのアップロードはスキップされる。
# サービスアカウントのメールアドレスをこのフォルダの編集者として共有しておくこと。
GDRIVE_BACKUP_FOLDER_ID=
# Google Drive OAuth（サービスアカウントは保存容量を持たないため、ユーザー本人の
# OAuth委任でファイル作成する。scripts/get_drive_token.js で取得したリフレッシュトークンを使う）。
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
# 主データストア（SQLite）のファイルパス。省略時は ./data/kakeibo.db
DB_FILE_PATH=
# スプレッドシート直接編集の同期用エンドポイント（/sheets-sync）の共有シークレット。
# GAS側のスクリプトプロパティにも同じ値を設定すること。
SHEETS_SYNC_SHARED_SECRET=
